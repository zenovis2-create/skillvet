{
  "name": "skillvet",
  "version": "0.2.0",
  "description": "Static verification of effective agent configuration and supply-chain posture for AI skills, MCP, Claude Code, and Codex.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenovis2-create/skillvet.git"
  },
  "homepage": "https://github.com/zenovis2-create/skillvet#readme",
  "bugs": {
    "url": "https://github.com/zenovis2-create/skillvet/issues"
  },
  "type": "module",
  "bin": {
    "skillvet": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node -e \"import('node:fs').then((fs)=>fs.chmodSync('dist/cli.js',0o755))\"",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "skillvet": "tsx src/cli.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "skill",
    "mcp",
    "security",
    "scanner",
    "supply-chain",
    "agent",
    "llm",
    "cli",
    "audit",
    "claude-code"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
